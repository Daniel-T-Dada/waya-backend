generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String    @id @default(uuid())
  email                   String    @unique
  name                    String    @map("full_name")
  password                String?
  role                    String    @default("parent")
  emailVerified           Boolean   @default(false) @map("is_verified")
  image                   String?   @map("avatar")
  phoneNumber             String?   @map("phone_number")
  notificationPreferences Json?     @map("notification_preferences")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  otpCode                 String?   @map("otp_code")
  otpExpiresAt            DateTime? @map("otp_expires_at")
  resetToken              String?   @map("reset_token")
  resetTokenExpiresAt     DateTime? @map("reset_token_expires_at")
  avatarPublicId          String?   @map("avatar_public_id")
  googleId                String?   @unique @map("google_id")
  verificationOtp         String?   @map("verification_otp")
  verificationOtpExpires  DateTime? @map("verification_otp_expires")

  children      Child[]
  wallet        Wallet?
  chores        Chore[]
  allowances    Allowance[]
  notifications Notification[]
  sessions      Session[]
  accounts      Account[]
  payments      Payment[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Child {
  id             String   @id @default(uuid())
  parentId       String   @map("parent_id")
  parent         User     @relation(fields: [parentId], references: [id], onDelete: Cascade)
  username       String   @unique
  name           String?
  pin            String // Hashed 4-digit PIN
  avatar         String?
  avatarPublicId String?  @map("avatar_public_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  wallet          ChildWallet?
  transactions    Transaction[]
  chores          Chore[]
  allowances      Allowance[]
  goals           Goal[]
  notifications   Notification[]
  quizAttempts    QuizAttempt[]
  learningRewards LearningReward[]
  dailyActivities DailyActivity[]
  currentStreak   Int              @default(0) @map("current_streak")
  lastActiveAt    DateTime?        @map("last_active_at")

  @@index([parentId])
  @@index([createdAt])
  @@map("child")
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Decimal  @default(0) @db.Decimal(10, 2)
  currency  String   @default("NGN")
  pin       String? // Optional wallet PIN (hashed)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  childWallets ChildWallet[]
  transactions Transaction[]

  @@map("wallet")
}

model ChildWallet {
  id             String   @id @default(uuid())
  childId        String   @unique @map("child_id")
  child          Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  parentWalletId String   @map("parent_wallet_id")
  parentWallet   Wallet   @relation(fields: [parentWalletId], references: [id], onDelete: Cascade)
  balance        Decimal  @default(0) @db.Decimal(10, 2)
  totalEarned    Decimal  @default(0) @map("total_earned") @db.Decimal(10, 2)
  totalSpent     Decimal  @default(0) @map("total_spent") @db.Decimal(10, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("child_wallet")
}

model Transaction {
  id               String   @id @default(uuid())
  type             String // 'credit', 'debit', 'transfer', 'reward'
  amount           Decimal  @db.Decimal(10, 2)
  status           String // 'pending', 'completed', 'cancelled', 'paid'
  description      String
  childId          String?  @map("child_id")
  child            Child?   @relation(fields: [childId], references: [id], onDelete: SetNull)
  walletId         String   @map("wallet_id")
  wallet           Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  choreId          String?  @map("chore_id") // For future chore integration
  paymentReference String?  @map("payment_reference") // Paystack payment reference
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([walletId])
  @@index([childId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@index([childId, createdAt])
  @@map("transaction")
}

model Chore {
  id          String    @id @default(uuid())
  title       String
  description String
  amount      Decimal   @db.Decimal(10, 2) // Reward amount
  dueDate     DateTime? @map("due_date")
  assignedTo  String    @map("assigned_to")
  child       Child     @relation(fields: [assignedTo], references: [id], onDelete: Cascade)
  parentId    String    @map("parent_id")
  parent      User      @relation(fields: [parentId], references: [id], onDelete: Cascade)
  status      String    @default("pending") // pending, awaiting_approval, completed, missed
  category    String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")

  @@index([parentId])
  @@index([assignedTo])
  @@index([status])
  @@index([dueDate])
  @@index([createdAt])
  @@index([assignedTo, status])
  @@index([parentId, status])
  @@map("chore")
}

model Allowance {
  id              String    @id @default(uuid())
  parentId        String    @map("parent_id")
  parent          User      @relation(fields: [parentId], references: [id], onDelete: Cascade)
  childId         String    @map("child_id")
  child           Child     @relation(fields: [childId], references: [id], onDelete: Cascade)
  amount          Decimal   @db.Decimal(10, 2)
  frequency       String // 'daily', 'weekly', 'monthly'
  status          String    @default("active") // 'active', 'paused', 'inactive'
  lastPaidAt      DateTime? @map("last_paid_at")
  nextPaymentDate DateTime  @map("next_payment_date")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([parentId])
  @@index([childId])
  @@map("allowance")
}

model Goal {
  id            String       @id @default(uuid())
  childId       String       @map("child_id")
  child         Child        @relation(fields: [childId], references: [id], onDelete: Cascade)
  title         String
  description   String
  targetAmount  Decimal      @map("target_amount") @db.Decimal(10, 2)
  currentAmount Decimal      @default(0) @map("current_amount") @db.Decimal(10, 2)
  status        String       @default("in_progress") // in_progress, completed, cancelled
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  completedAt   DateTime?    @map("completed_at")
  rewards       GoalReward[]

  @@index([childId])
  @@map("goal")
}

model GoalReward {
  id       String   @id @default(uuid())
  goalId   String   @map("goal_id")
  goal     Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  amount   Decimal  @db.Decimal(10, 2)
  earnedAt DateTime @default(now()) @map("earned_at")

  @@index([goalId])
  @@map("goal_reward")
}

model Notification {
  id                String   @id @default(uuid())
  userId            String?  @map("user_id") // Parent ID
  user              User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  childId           String?  @map("child_id") // Child ID
  child             Child?   @relation(fields: [childId], references: [id], onDelete: Cascade)
  type              String // e.g., 'chore_completed', 'allowance_paid', 'goal_reached'
  title             String
  message           String
  isRead            Boolean  @default(false) @map("is_read")
  relatedObjectType String?  @map("related_object_type") // e.g., 'chore', 'allowance', 'goal'
  relatedObjectId   String?  @map("related_object_id")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([childId])
  @@index([isRead])
  @@index([userId, isRead])
  @@index([childId, isRead])
  @@map("notification")
}

model DailyActivity {
  id           String   @id @default(uuid())
  childId      String   @map("child_id")
  child        Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  date         DateTime @default(now()) // Truncated to day in code
  activityType String   @map("activity_type") // 'quiz', 'chore', 'saving', etc.

  @@unique([childId, date])
  @@index([childId])
  @@map("daily_activity")
}

model Concept {
  id          String   @id @default(uuid())
  title       String
  description String
  level       Int      @default(1)
  order       Int      @default(1)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  quizzes     Quiz[]

  @@map("concept")
}

model Quiz {
  id           String           @id @default(uuid())
  conceptId    String           @map("concept_id")
  concept      Concept          @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  title        String
  description  String
  passingScore Int              @default(70) @map("passing_score")
  questions    Question[]
  attempts     QuizAttempt[]
  rewards      LearningReward[]

  @@map("quiz")
}

model Question {
  id           String         @id @default(uuid())
  quizId       String         @map("quiz_id")
  quiz         Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionText String         @map("question_text")
  questionType String         @default("multiple_choice") @map("question_type")
  choices      AnswerChoice[]

  @@map("question")
}

model AnswerChoice {
  id         String   @id @default(uuid())
  questionId String   @map("question_id")
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  choiceText String   @map("choice_text")
  isCorrect  Boolean  @default(false) @map("is_correct")

  @@map("answer_choice")
}

model QuizAttempt {
  id             String   @id @default(uuid())
  childId        String   @map("child_id")
  child          Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  quizId         String   @map("quiz_id")
  quiz           Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score          Int
  passed         Boolean
  correctAnswers Int      @map("correct_answers")
  totalQuestions Int      @map("total_questions")
  rewardEarned   Decimal  @default(0) @map("reward_earned") @db.Decimal(10, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([childId])
  @@index([quizId])
  @@map("quiz_attempt")
}

model LearningReward {
  id       String   @id @default(uuid())
  childId  String   @map("child_id")
  child    Child    @relation(fields: [childId], references: [id], onDelete: Cascade)
  quizId   String   @map("quiz_id")
  quiz     Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  amount   Decimal  @db.Decimal(10, 2)
  earnedAt DateTime @default(now()) @map("earned_at")

  @@index([childId])
  @@index([quizId])
  @@map("learning_reward")
}

model Payment {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reference         String    @unique // Paystack payment reference
  amount            Decimal   @db.Decimal(10, 2)
  currency          String    @default("NGN")
  status            String    @default("pending") // pending, success, failed, abandoned
  channel           String? // card, bank, ussd, etc.
  paystackResponse  Json?     @map("paystack_response")
  transactionId     String?   @unique @map("transaction_id") // Link to Transaction model
  metadata          Json?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  verifiedAt        DateTime? @map("verified_at")

  @@index([userId])
  @@index([reference])
  @@index([status])
  @@index([createdAt])
  @@map("payment")
}
